<UserControl x:Class="AadharLocation.AdminDashboard.Controls.DateRangePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Self">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Toggle button — custom template keeps the same look as the dropdown toggles -->
        <ToggleButton x:Name="ToggleBtn" Height="40"
                      Background="Transparent" Cursor="Hand"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Style="{x:Null}"
                      PreviewMouseLeftButtonDown="ToggleBtn_PreviewMouseLeftButtonDown"
                      Click="ToggleBtn_Click">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="4"
                            Background="{TemplateBinding Background}" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="RangeDisplay"
                                       Text="Select date range" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <materialDesign:PackIcon Grid.Column="1" Kind="CalendarRange"
                                                     Width="16" Height="16" VerticalAlignment="Center"
                                                     Foreground="#2DD4BF" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- Calendar popup -->
        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=ToggleBtn}"
               Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Slide"
               Closed="CalendarPopup_Closed">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="6"
                    Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Hint text -->
                    <TextBlock x:Name="HintText"
                               Text="Click to select start date"
                               FontSize="11" Margin="0,0,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>

                    <!-- Calendar -->
                    <Calendar x:Name="RangeCalendar"
                              SelectionMode="MultipleRange"
                              PreviewMouseLeftButtonDown="RangeCalendar_PreviewMouseLeftButtonDown"/>

                    <!-- Footer buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Clear" Style="{StaticResource GhostButtonStyle}"
                                Click="ClearButton_Click" Padding="10,5" Margin="0,0,8,0"/>
                        <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyButton_Click" Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
