<UserControl x:Class="AadharLocation.AdminDashboard.Views.Pages.FleetMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:AadharLocation.AdminDashboard.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Converters/ConverterResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Map -->
        <Grid Grid.Column="0">
            <wv2:WebView2 x:Name="MapWebView" Margin="0"/>

            <!-- Status bar -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="12" Background="#AA000000">
                <Border Padding="8,4" CornerRadius="4">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                </Border>
            </StackPanel>

            <!-- Loading -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                  Background="#66000000">
                <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Value="35"/>
            </Grid>
        </Grid>

        <!-- Side panel -->
        <Border Grid.Column="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,0,0,0">
            <DockPanel>

                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                    <TextBlock Text="Fleet Map" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding MachineCountText}"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                </StackPanel>

                <!-- Filter search bar -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,10"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding MachineFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Search machine, operator, city..."
                                 materialDesign:HintAssist.Foreground="{DynamicResource SecondaryTextBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                                 BorderThickness="0" Margin="8,0,0,0" VerticalAlignment="Center"
                                 FontSize="12" Padding="4,6"/>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                Width="30" Height="30" Padding="0"
                                Command="{Binding ApplyMachineFilterCommand}"
                                Foreground="{StaticResource BrandTealBrush}"
                                ToolTip="Search">
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                Width="28" Height="28" Padding="0"
                                Command="{Binding ClearMachineFilterCommand}"
                                Visibility="{Binding MachineFilterText, Converter={StaticResource StringNotEmptyToVisibility}}"
                                ToolTip="Clear">
                            <materialDesign:PackIcon Kind="Close" Width="13" Height="13"/>
                        </Button>
                    </Grid>
                </Border>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource SeparatorBrush}" Height="1" Margin="0"/>

                <!-- Machine list -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredPins}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="4,2" CornerRadius="6"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectPinCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                 Fill="{Binding Status, Converter={StaticResource StatusColor}}"
                                                 VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding MachineName}" FontWeight="Medium" FontSize="13"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding OperatorName}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                            <TextBlock Foreground="{DynamicResource TertiaryTextBrush}" FontSize="10" Margin="0,2,0,0">
                                                <Run Text="Lat: "/>
                                                <Run Text="{Binding Latitude, StringFormat=F4}"/>
                                                <Run Text="  Lon: "/>
                                                <Run Text="{Binding Longitude, StringFormat=F4}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding City}" FontSize="10"
                                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                                       HorizontalAlignment="Right" FontWeight="Medium"
                                                       Visibility="{Binding City, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                                            <materialDesign:PackIcon Kind="AlertCircle" Width="14" Height="14"
                                                                      Foreground="#F87171" HorizontalAlignment="Right"
                                                                      Visibility="{Binding IsWithinGeofence,
                                                                          Converter={StaticResource BoolToVisibility},
                                                                          ConverterParameter=Inverse}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Selected pin detail -->
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" CornerRadius="8"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Visibility="{Binding SelectedPin, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <!-- Machine name + status dot -->
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding SelectedPin.Status, Converter={StaticResource StatusColor}}"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SelectedPin.MachineName}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <!-- Operator -->
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">
                            <Run Text="Operator: "/><Run Text="{Binding SelectedPin.OperatorName}"/>
                        </TextBlock>

                        <!-- Coordinates -->
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">
                            <Run Text="Lat: "/><Run Text="{Binding SelectedPin.Latitude, StringFormat=F6}"/>
                            <Run Text="  Lon: "/><Run Text="{Binding SelectedPin.Longitude, StringFormat=F6}"/>
                        </TextBlock>

                        <!-- Address loading -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding IsLoadingAddress, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar IsIndeterminate="True" Height="2"/>
                            <TextBlock Text="Fetching location..." Foreground="{DynamicResource TertiaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Address -->
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding SelectedPinAddress}"
                                   Visibility="{Binding SelectedPinAddress, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
