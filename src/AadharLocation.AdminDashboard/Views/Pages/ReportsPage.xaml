<UserControl x:Class="AadharLocation.AdminDashboard.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AadharLocation.AdminDashboard.Converters"
             xmlns:controls="clr-namespace:AadharLocation.AdminDashboard.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Converters/ConverterResources.xaml"/>
                <ResourceDictionary Source="/Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Reports" FontSize="24" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,0,16"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <!-- Filter card -->
        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource MaterialDesignPaper}"
                Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Machines multi-select dropdown -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Machines" FontSize="11" Opacity="0.6" Margin="0,0,0,6"/>
                    <Grid>
                        <ToggleButton x:Name="MachineToggle"
                                      Content="{Binding MachinesSummary}"
                                      Style="{StaticResource DropdownToggleStyle}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=MachineToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=MachineToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               MinWidth="{Binding ActualWidth, ElementName=MachineToggle}">
                            <Border Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="#2DD4BF" BorderThickness="1"
                                    CornerRadius="4" Padding="4">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding MachineItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="8,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Operators multi-select dropdown -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Operators" FontSize="11" Opacity="0.6" Margin="0,0,0,6"/>
                    <Grid>
                        <ToggleButton x:Name="OperatorToggle"
                                      Content="{Binding OperatorsSummary}"
                                      Style="{StaticResource DropdownToggleStyle}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=OperatorToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=OperatorToggle}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               MinWidth="{Binding ActualWidth, ElementName=OperatorToggle}">
                            <Border Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="#2DD4BF" BorderThickness="1"
                                    CornerRadius="4" Padding="4">
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding OperatorItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="8,4"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Date range + action buttons -->
                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Date Range" FontSize="11" Opacity="0.6" Margin="0,0,0,6"/>
                    <DatePicker materialDesign:HintAssist.Hint="From date"
                                SelectedDate="{Binding FromDate}"
                                Style="{StaticResource MaterialDesignDatePicker}"
                                Width="180" Margin="0,0,0,8"/>
                    <DatePicker materialDesign:HintAssist.Hint="To date"
                                SelectedDate="{Binding ToDate}"
                                Style="{StaticResource MaterialDesignDatePicker}"
                                Width="180" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Apply Filters"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Export CSV"
                                Command="{Binding ExportCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Email report bar -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock Text="Email Report To:" FontSize="11" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Enter email address..."
                             Style="{StaticResource MaterialDesignTextBox}"
                             Width="280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Send Report"
                            Command="{Binding SendReportByEmailCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data grid -->
        <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource MaterialDesignPaper}"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding ReportRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      materialDesign:DataGridAssist.CellPadding="12 8 12 8">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Type" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,2" CornerRadius="4"
                                        Background="{Binding AlertType, Converter={StaticResource AlertTypeColor}}">
                                    <TextBlock Text="{Binding AlertType}" Foreground="White"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Machine"  Binding="{Binding MachineName}"  Width="*"/>
                    <DataGridTextColumn Header="Operator" Binding="{Binding OperatorName}" Width="*"/>
                    <DataGridTextColumn Header="Message"  Binding="{Binding Message}"      Width="2*"/>
                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding CreatedAt, Converter={StaticResource DateTimeConverter}}"
                                        Width="150"/>
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsAcknowledged, Converter={StaticResource BoolToAck}}"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4ADE80"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAcknowledged}" Value="False">
                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                <TextBlock Text="{Binding ExportStatus}" Foreground="#2DD4BF" Margin="8,0,0,0"
                           Visibility="{Binding ExportStatus, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            </StackPanel>
            <controls:PaginationControl Grid.Column="1"
                CurrentPage="{Binding CurrentPage, Mode=OneWay}"
                TotalPages="{Binding TotalPages, Mode=OneWay}"
                TotalCount="{Binding TotalCount, Mode=OneWay}"
                PageSize="{Binding PageSize, Mode=OneWay}"
                GoToPageCommand="{Binding GoToPageCommand}"
                ChangePageSizeCommand="{Binding ChangePageSizeCommand}"/>
        </Grid>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="4"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
              Background="#66000000">
            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Value="35"/>
        </Grid>
    </Grid>
</UserControl>
