<UserControl x:Class="AadharLocation.AdminDashboard.Views.Pages.AdminsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AadharLocation.AdminDashboard.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Converters/ConverterResources.xaml"/>
                <ResourceDictionary Source="/Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Admin Users" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Grid.Column="1" Content="+ Add Admin"
                    Command="{Binding AddAdminCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource MaterialDesignPaper}"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Admins}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      RowHeight="44"
                      materialDesign:DataGridAssist.CellPadding="12 0 12 0"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="12 14 12 14">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Resources>
                    <Style x:Key="CellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"                                     Width="*"   ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Email"   Binding="{Binding Email}"                                    Width="*"   ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy}}" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="Actions" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                    <Button Width="32" Height="32" Padding="4"
                                            ToolTip="Edit"
                                            Command="{Binding DataContext.EditAdminCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource StringNotEqual}">
                                                <Binding Path="Email"/>
                                                <Binding Path="DataContext.CurrentUserEmail"
                                                         RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                    </Button>
                                    <Button Width="32" Height="32" Padding="4"
                                            ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteAdminCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{StaticResource StringNotEqual}">
                                                <Binding Path="Email"/>
                                                <Binding Path="DataContext.CurrentUserEmail"
                                                         RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Setter Property="Foreground" Value="#F87171"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Error + loading -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#F87171"
                   Margin="0,12,0,0" FontSize="12"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}"/>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
              Background="#66000000">
            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Value="35"/>
        </Grid>
    </Grid>
</UserControl>
