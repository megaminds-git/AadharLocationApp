<Window x:Class="AadharLocation.AdminDashboard.Views.Dialogs.MachineStatusDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="560" Width="640"
        MinHeight="380" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Converters/ConverterResources.xaml"/>
                <ResourceDictionary Source="/Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24" TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row with Export button -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Machine details with last known location"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="ExportCsvButton"
                    Style="{StaticResource GhostButtonStyle}"
                    VerticalAlignment="Center"
                    Click="ExportCsv_Click">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export to CSV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </Grid>

        <!-- Separator -->
        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="0,0,0,8"/>

        <!-- Content area: list + empty state -->
        <Grid Grid.Row="2">

            <!-- Machine list -->
            <ListView ItemsSource="{Binding Items}"
                      BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,12" Margin="0,0,0,4" CornerRadius="6"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource SeparatorBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status dot -->
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                         Fill="{Binding Status, Converter={StaticResource StatusColor}}"
                                         VerticalAlignment="Top" Margin="0,4,0,0"/>

                                <!-- Machine info -->
                                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock FontSize="12" Margin="0,3,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="Operator: "/><Run Text="{Binding OperatorName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Coordinates}"
                                               FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <materialDesign:PackIcon Kind="MapMarkerOutline" Width="12" Height="12"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TertiaryTextBrush}"
                                                                 Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding City}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TertiaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Last seen -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding LastSeen}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <materialDesign:PackIcon Kind="InformationOutline" Width="40" Height="40"
                                         Foreground="{DynamicResource TertiaryTextBrush}"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="No machines in this category"
                           FontSize="13" Foreground="{DynamicResource TertiaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

        </Grid>

        <!-- Footer -->
        <Button Grid.Row="3" Content="Close" Style="{StaticResource GhostButtonStyle}"
                HorizontalAlignment="Right" IsCancel="True" Margin="0,14,0,0"/>

    </Grid>
</Window>
