<Window x:Class="AadharLocation.AdminDashboard.Views.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Change Password"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Converters/ConverterResources.xaml"/>
                <ResourceDictionary Source="/Styles/Buttons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RevealPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource BrandTealBrush}"/>
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            </Style>
            <Style x:Key="RevealTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource BrandTealBrush}"/>
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28" TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Change Password"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Enter your current password to set a new one."
                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,0,0,16"/>
        <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="0,0,0,20"/>

        <!-- Form fields -->
        <StackPanel Grid.Row="3">

            <!-- Current password -->
            <Grid Margin="0,0,0,16">
                <PasswordBox x:Name="CurrentPwdBox" Style="{StaticResource RevealPasswordBox}"
                             materialDesign:HintAssist.Hint="Current password"
                             materialDesign:PasswordBoxAssist.Password="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox x:Name="CurrentPwdText" Style="{StaticResource RevealTextBox}"
                         materialDesign:HintAssist.Hint="Current password"
                         Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"/>
                <ToggleButton x:Name="CurrentPwdToggle"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,4,4,0"
                              Style="{StaticResource MaterialDesignIconButton}"
                              Width="28" Height="28"
                              Click="CurrentPwdToggle_Click"
                              Foreground="{DynamicResource SecondaryTextBrush}">
                    <materialDesign:PackIcon x:Name="CurrentPwdIcon" Kind="Eye" Width="16" Height="16"/>
                </ToggleButton>
            </Grid>

            <!-- New password -->
            <Grid Margin="0,0,0,16">
                <PasswordBox x:Name="NewPwdBox" Style="{StaticResource RevealPasswordBox}"
                             materialDesign:HintAssist.Hint="New password"
                             materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox x:Name="NewPwdText" Style="{StaticResource RevealTextBox}"
                         materialDesign:HintAssist.Hint="New password"
                         Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"/>
                <ToggleButton x:Name="NewPwdToggle"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,4,4,0"
                              Style="{StaticResource MaterialDesignIconButton}"
                              Width="28" Height="28"
                              Click="NewPwdToggle_Click"
                              Foreground="{DynamicResource SecondaryTextBrush}">
                    <materialDesign:PackIcon x:Name="NewPwdIcon" Kind="Eye" Width="16" Height="16"/>
                </ToggleButton>
            </Grid>

            <!-- Confirm new password -->
            <Grid Margin="0,0,0,0">
                <PasswordBox x:Name="ConfirmPwdBox" Style="{StaticResource RevealPasswordBox}"
                             materialDesign:HintAssist.Hint="Confirm new password"
                             materialDesign:PasswordBoxAssist.Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox x:Name="ConfirmPwdText" Style="{StaticResource RevealTextBox}"
                         materialDesign:HintAssist.Hint="Confirm new password"
                         Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"/>
                <ToggleButton x:Name="ConfirmPwdToggle"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,4,4,0"
                              Style="{StaticResource MaterialDesignIconButton}"
                              Width="28" Height="28"
                              Click="ConfirmPwdToggle_Click"
                              Foreground="{DynamicResource SecondaryTextBrush}">
                    <materialDesign:PackIcon x:Name="ConfirmPwdIcon" Kind="Eye" Width="16" Height="16"/>
                </ToggleButton>
            </Grid>

            <!-- Status message -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#4ADE80"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#F87171"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                    IsCancel="True"/>
            <Button Grid.Column="3" Content="Change Password" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ChangePasswordCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
        </Grid>
    </Grid>
</Window>
